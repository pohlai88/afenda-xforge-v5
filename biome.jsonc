{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react",
    "ultracite/biome/vitest"
  ],
  "files": {
    // Vendored agent skills / reference docs — not our source; reformatting
    // them breaks skills-lock.json hashes. Ultracite's own ignores use `!!`
    // and survive this list.
    // Deprecated key, kept on purpose: it is the only setting that stops the
    // scanner indexing dependency typings. With zod in the graph, Biome's type
    // inference took ~20 s per check (72 ms with this). The suggested
    // "!!**/node_modules" in includes does not have the same effect (measured).
    // tsc owns cross-package types; Biome stays syntactic for node_modules.
    "experimentalScannerIgnores": ["node_modules"],
    "includes": ["!.agents", "!.claude", "!skills-lock.json"]
  },
  "overrides": [
    {
      // The contract package is framework-blind: zod only. A React, Next or
      // app import here would drag the domain into a runtime it must not know.
      "includes": ["packages/contracts/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next": "contracts are framework-blind",
                  "react": "contracts are framework-blind",
                  "react-dom": "contracts are framework-blind",
                  "server-only": "contracts run anywhere"
                },
                "patterns": [
                  {
                    "group": [
                      "next/*",
                      "react/*",
                      "@/*",
                      "@xforge/design*",
                      "@xforge/web*"
                    ],
                    "message": "contracts are framework-blind and app-blind"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Features and routes reach data only through @/lib/data; the adapters
      // and the fixtures are implementation details of that module.
      "includes": [
        "apps/web/app/**",
        "apps/web/components/**",
        "apps/web/features/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/lib/data/adapters/*",
                      "@xforge/contracts/fixtures/*"
                    ],
                    "message": "import getDomainSources from @/lib/data instead"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // shadcn's CLI generates these in its own style: namespace React import,
      // cva variant maps ordered by meaning rather than alphabetically.
      "includes": ["packages/design/src/components/**"],
      "assist": { "actions": { "source": { "useSortedKeys": "off" } } },
      "linter": {
        "rules": {
          // Upstream style in generated files; kept pristine so  stays useful.
          "a11y": { "useSemanticElements": "off" },
          "performance": { "noNamespaceImport": "off" },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDoubleEquals": "off",
            "noLeakedRender": "off",
            "noUnnecessaryConditions": "off"
          }
        }
      }
    },
    {
      // shadcn's CLI generates lib/utils.ts as a re-export of `cn`.
      "includes": ["packages/design/src/lib/**"],
      "linter": { "rules": { "performance": { "noBarrelFile": "off" } } }
    }
  ]
}
