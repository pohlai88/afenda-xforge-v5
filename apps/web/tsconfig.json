{
  "extends": "@xforge/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@xforge/design/blocks/common-button": [
        "../../packages/design/src/blocks/common-button/common-button.tsx"
      ],
      "@xforge/design/blocks/dialog": [
        "../../packages/design/src/blocks/dialog/dialog.tsx"
      ],
      "@xforge/design/*": ["../../packages/design/src/*"],
      "@xforge/contracts/*": ["../../packages/contracts/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
