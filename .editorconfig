# Mirrors the Biome formatter settings from ultracite/biome/core so editors
# without the Biome extension still produce the same shape.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Lockfiles and generated files are not hand-edited.
[{pnpm-lock.yaml,skills-lock.json}]
indent_size = unset
insert_final_newline = unset
